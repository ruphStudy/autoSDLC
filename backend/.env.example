DATABASE_URL="postgresql://autosdlc:autosdlc@localhost:5434/autosdlc?schema=public"

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# JWT access token secret and lifetime
JWT_ACCESS_SECRET=change-me-in-every-environment
JWT_ACCESS_EXPIRES_IN=15m

# JWT refresh token secret and lifetime
JWT_REFRESH_SECRET=change-me-in-every-environment
JWT_REFRESH_EXPIRES_IN=7d

# Planning AI provider (only "openai" is currently supported)
PLANNING_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-4o-mini
OPENAI_PLANNING_TIMEOUT_MS=90000
OPENAI_PLANNING_MAX_RETRIES=2
OPENAI_PLANNING_TEMPERATURE=0.2
