DATABASE_URL="postgresql://autosdlc:autosdlc@localhost:5434/autosdlc?schema=public"

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# JWT access token secret and lifetime
JWT_ACCESS_SECRET=change-me-in-every-environment
JWT_ACCESS_EXPIRES_IN=15m

# JWT refresh token secret and lifetime
JWT_REFRESH_SECRET=change-me-in-every-environment
JWT_REFRESH_EXPIRES_IN=7d

# Planning AI provider (only "openai" is currently supported)
PLANNING_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-4o-mini
OPENAI_PLANNING_TIMEOUT_MS=90000
OPENAI_PLANNING_MAX_RETRIES=2
OPENAI_PLANNING_TEMPERATURE=0.2

# Background job worker (always disabled under NODE_ENV=test regardless of this flag)
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=2000
JOB_BATCH_SIZE=5
JOB_LOCK_TIMEOUT_SECONDS=300
JOB_HEARTBEAT_SECONDS=60
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_SECONDS=5
JOB_RETRY_MAX_DELAY_SECONDS=300
JOB_MAX_PAYLOAD_BYTES=65536
JOB_MAX_RESULT_BYTES=65536

# Git/workspace infrastructure (must stay outside this repository)
WORKSPACE_ROOT=/tmp/autosdlc-workspaces
WORKSPACE_MAX_SIZE_MB=2048
GIT_COMMAND_TIMEOUT_MS=60000
GIT_CLONE_TIMEOUT_MS=180000
GIT_DEFAULT_BRANCH=main
GIT_MAX_OUTPUT_BYTES=1048576
GIT_AUTHOR_NAME=Autonomous Dev Orchestrator
GIT_AUTHOR_EMAIL=autodev@localhost
