// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  isActive         Boolean   @default(true)
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  projects         Project[]

  @@map("users")
}

enum AnalysisSource {
  AI_GENERATED
  USER_EDITED
}

enum RepositoryType {
  NEW
  EXISTING
}

enum ProjectStatus {
  DRAFT
  ANALYZING
  ANALYSIS_READY
  PLANNING
  PLAN_READY
  AWAITING_APPROVAL
  DEVELOPING
  TESTING
  COMPLETED
  FAILED
  PAUSED
}

// Root domain object for a user's product idea. Later sprints (analysis,
// architecture, sprint planning, execution) hang their own models off this
// via `projectId` rather than growing this table with their JSON output.
model Project {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  brief          String
  preferredStack String?
  repositoryType RepositoryType    @default(NEW)
  repositoryUrl  String?
  status         ProjectStatus     @default(DRAFT)
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  analyses       ProjectAnalysis[]

  @@index([userId, archivedAt])
  @@map("projects")
}

// Structured, versioned output of the Project Analysis Engine. Deliberately
// not columns on Project: analysis is regenerable business state produced by
// PlanningAIProvider, not a property of the project itself. Each row is a
// full immutable snapshot (never mutated in place) — "current" is simply
// the highest `version` for a project.
model ProjectAnalysis {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  version        Int
  source         AnalysisSource
  basedOnVersion Int?

  summary                   String
  targetUsers               Json
  goals                     Json
  features                  Json
  functionalRequirements    Json
  nonFunctionalRequirements Json
  assumptions               Json
  risks                     Json
  unresolvedQuestions       Json
  integrations              Json

  // Null on USER_EDITED versions — no AI call produced them.
  promptName        String?
  promptVersion     String?
  provider          String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  latencyMs         Int?
  attempts          Int?
  providerRequestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("project_analyses")
}
