// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String             @id @default(uuid())
  email                     String             @unique
  passwordHash              String
  firstName                 String?
  lastName                  String?
  isActive                  Boolean            @default(true)
  refreshTokenHash          String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  projects                  Project[]
  approvalsDecided          Approval[]
  sprintAcceptancesReviewed SprintAcceptance[]
  jobs                      Job[]

  @@map("users")
}

// Generic provenance for any versioned AI-generated domain entity (not
// analysis-specific despite the name) — reused by Architecture below rather
// than adding an identical duplicate enum.
enum AnalysisSource {
  AI_GENERATED
  USER_EDITED
}

enum RepositoryType {
  NEW
  EXISTING
}

enum ProjectStatus {
  DRAFT
  ANALYZING
  ANALYSIS_READY
  ANALYSIS_APPROVED
  PLANNING
  ARCHITECTURE_READY
  ARCHITECTURE_APPROVED
  PLAN_READY
  PLAN_APPROVED
  DEVELOPMENT_APPROVED
  AWAITING_APPROVAL
  DEVELOPING
  TESTING
  COMPLETED
  FAILED
  PAUSED
}

enum ApprovalStage {
  ANALYSIS
  ARCHITECTURE
  SPRINT_PLAN
  START_DEVELOPMENT
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum ApprovalArtifactType {
  PROJECT_ANALYSIS
  ARCHITECTURE
  SPRINT_PLAN
  PROJECT
}

// Planning-time statuses only. Sprint 12+ (execution orchestration) is what
// actually moves these away from PENDING — Sprint 6 never sets anything but
// the initial value.
enum SprintStatus {
  PENDING
  RUNNING
  TESTING
  PASSED
  FAILED
  BLOCKED
}

enum TaskStatus {
  PENDING
  READY
  RUNNING
  REVIEWING
  PASSED
  FAILED
  BLOCKED
}

// Deliberately narrow for Sprint 8: only infrastructure/test-safe types.
// Future sprints add their own real work types here (and register a
// handler for each) — this enum is not meant to anticipate them.
enum TaskExecutionStatus {
  QUEUED
  RUNNING
  AGENT_COMPLETED
  READY_FOR_VALIDATION
  FAILED
  CANCELLED
}

enum JobType {
  SYSTEM_TEST
  PROJECT_PREPARATION
  WORKSPACE_PREPARE
  CODING_AGENT_EXECUTION
  TASK_EXECUTION
  TASK_VALIDATION
  SPRINT_EXECUTION
  SPRINT_ACCEPTANCE_REVIEW
}

enum JobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobEventType {
  CREATED
  CLAIMED
  STARTED
  PROGRESS
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
  LOCK_RECOVERED
}

// Root domain object for a user's product idea. Later sprints (analysis,
// architecture, sprint planning, execution) hang their own models off this
// via `projectId` rather than growing this table with their JSON output.
model Project {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  brief              String
  preferredStack     String?
  repositoryType     RepositoryType      @default(NEW)
  repositoryUrl      String?
  status             ProjectStatus       @default(DRAFT)
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  analyses           ProjectAnalysis[]
  architectures      Architecture[]
  sprintPlans        SprintPlan[]
  approvals          Approval[]
  jobs               Job[]
  workspace          ProjectWorkspace?
  agentJobs          AgentJob[]
  taskInstructions   TaskInstruction[]
  taskExecutions     TaskExecution[]
  validationAttempts ValidationAttempt[]
  sprintExecutions   SprintExecution[]
  sprintAcceptances  SprintAcceptance[]

  @@index([userId, archivedAt])
  @@map("projects")
}

// Structured, versioned output of the Project Analysis Engine. Deliberately
// not columns on Project: analysis is regenerable business state produced by
// PlanningAIProvider, not a property of the project itself. Each row is a
// full immutable snapshot (never mutated in place) — "current" is simply
// the highest `version` for a project.
model ProjectAnalysis {
  id            String         @id @default(uuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architectures Architecture[]
  approvals     Approval[]

  version        Int
  source         AnalysisSource
  basedOnVersion Int?

  summary                   String
  targetUsers               Json
  goals                     Json
  features                  Json
  functionalRequirements    Json
  nonFunctionalRequirements Json
  assumptions               Json
  risks                     Json
  unresolvedQuestions       Json
  integrations              Json

  // Null on USER_EDITED versions — no AI call produced them.
  promptName        String?
  promptVersion     String?
  provider          String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  latencyMs         Int?
  attempts          Int?
  providerRequestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("project_analyses")
}

// Structured, versioned technical design produced from a specific
// ProjectAnalysis version. ProjectAnalysis describes WHAT must be built;
// Architecture describes HOW — kept as its own entity (not a field on either
// Project or ProjectAnalysis) for the same reason ProjectAnalysis is its own
// entity: it is regenerable, versioned business output, not a property of
// its parent.
model Architecture {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintPlans SprintPlan[]
  approvals   Approval[]

  // Exactly which analysis version this architecture was built from —
  // survives later ProjectAnalysis regeneration/edits so historical
  // architecture always shows its true lineage instead of a version number
  // that could later become ambiguous.
  projectAnalysisId String
  projectAnalysis   ProjectAnalysis @relation(fields: [projectAnalysisId], references: [id], onDelete: Cascade)

  version        Int
  source         AnalysisSource
  basedOnVersion Int?

  summary                    String
  frontendArchitecture       Json
  backendArchitecture        Json
  apiArchitecture            Json
  databaseArchitecture       Json
  authenticationArchitecture Json
  integrationArchitecture    Json
  infrastructureArchitecture Json
  deploymentArchitecture     Json
  securityArchitecture       Json
  testingStrategy            Json
  nonFunctionalDecisions     Json
  architectureDecisions      Json
  requirementTraceability    Json
  unresolvedQuestions        Json
  constraints                Json

  // Null on USER_EDITED versions — no AI call produced them.
  promptName        String?
  promptVersion     String?
  provider          String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  latencyMs         Int?
  attempts          Int?
  providerRequestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@index([projectAnalysisId])
  @@map("architectures")
}

// Structured, versioned delivery strategy produced from a specific
// Architecture version. Architecture describes HOW the product should be
// built; SprintPlan breaks that into an ordered, dependency-checked sequence
// of Sprints and Tasks ready for later autonomous execution. Like
// ProjectAnalysis/Architecture, this is its own entity — never a JSON blob
// on Project — and each version's Sprint/Task graph is immutable once
// created; regeneration or editing creates a whole new graph rather than
// touching the old one.
model SprintPlan {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Exactly which architecture version this plan was built from — survives
  // later Architecture regeneration/edits so historical plans always show
  // their true lineage.
  architectureId String
  architecture   Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)

  version        Int
  source         AnalysisSource
  basedOnVersion Int?

  summary              String
  strategy             String
  estimatedSprintCount Int?

  // Null on USER_EDITED versions — no AI call produced them.
  promptName        String?
  promptVersion     String?
  provider          String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  latencyMs         Int?
  attempts          Int?
  providerRequestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sprints   Sprint[]
  tasks     Task[]
  approvals Approval[]

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@index([architectureId])
  @@map("sprint_plans")
}

model Sprint {
  id           String     @id @default(uuid())
  sprintPlanId String
  sprintPlan   SprintPlan @relation(fields: [sprintPlanId], references: [id], onDelete: Cascade)

  number      Int
  title       String
  objective   String
  description String?
  status      SprintStatus @default(PENDING)
  order       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  // "This sprint depends on ..." / "... sprints that depend on this one".
  dependencies SprintDependency[] @relation("SprintDependencies")
  dependents   SprintDependency[] @relation("SprintDependents")

  executions  SprintExecution[]
  acceptances SprintAcceptance[]

  @@unique([sprintPlanId, number])
  @@index([sprintPlanId, order])
  @@map("sprints")
}

// Explicit join row rather than an int/string array: a real relational graph
// is what later orchestration needs to answer "can this sprint start yet?" —
// see also TaskDependency below for the same reasoning at task granularity.
model SprintDependency {
  id                String @id @default(uuid())
  sprintId          String
  dependsOnSprintId String
  sprint            Sprint @relation("SprintDependencies", fields: [sprintId], references: [id], onDelete: Cascade)
  dependsOnSprint   Sprint @relation("SprintDependents", fields: [dependsOnSprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, dependsOnSprintId])
  @@map("sprint_dependencies")
}

model Task {
  id           String     @id @default(uuid())
  // Denormalized alongside `sprintId` specifically so task keys can be
  // enforced unique across the *whole plan* (`@@unique([sprintPlanId,
  // key])`), not merely within one sprint, without an awkward cross-table
  // query — and so future orchestration can list "all tasks in this plan"
  // directly.
  sprintPlanId String
  sprintPlan   SprintPlan @relation(fields: [sprintPlanId], references: [id], onDelete: Cascade)
  sprintId     String
  sprint       Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  key         String
  title       String
  description String
  status      TaskStatus @default(PENDING)
  order       Int

  // MVP: JSON arrays, not one-row-per-criterion tables (section 64) — these
  // are descriptive planning content, not relationships later orchestration
  // needs to traverse the way task dependencies are.
  acceptanceCriteria     Json
  validationExpectations Json
  requirementIds         Json
  architectureAreas      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dependencies       TaskDependency[]    @relation("TaskDependencies")
  dependents         TaskDependency[]    @relation("TaskDependents")
  agentJobs          AgentJob[]
  instructions       TaskInstruction[]
  executions         TaskExecution[]
  validationAttempts ValidationAttempt[]

  @@unique([sprintPlanId, key])
  @@index([sprintId, order])
  @@map("tasks")
}

model TaskDependency {
  id              String @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  task            Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task   @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

// Explicit human sign-off on a specific, exact planning-artifact version.
// Append-only: every decision (approve or request-changes) is preserved as
// its own row, never overwritten — "is the CURRENT version approved" is a
// query (latest decision whose FK matches the current artifact row), not a
// mutable flag. A real FK per artifact type (not a generic string id) means
// an approval can never be mistaken for applying to the wrong version or the
// wrong kind of artifact. START_DEVELOPMENT has no single artifact FK — it
// approves the project's aggregate planning readiness, not one versioned
// row — so all three FKs stay null for that stage; its correctness comes
// from re-checking the other three stages live (see
// ApprovalService.assertDevelopmentApproved), not from a stored snapshot.
model Approval {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  stage        ApprovalStage
  decision     ApprovalDecision
  artifactType ApprovalArtifactType

  projectAnalysisId String?
  projectAnalysis   ProjectAnalysis? @relation(fields: [projectAnalysisId], references: [id], onDelete: Cascade)
  architectureId    String?
  architecture      Architecture?    @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  sprintPlanId      String?
  sprintPlan        SprintPlan?      @relation(fields: [sprintPlanId], references: [id], onDelete: Cascade)

  comment String?

  decidedByUserId String
  decidedByUser   User     @relation(fields: [decidedByUserId], references: [id], onDelete: Cascade)
  decidedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, stage, decidedAt])
  @@index([projectAnalysisId])
  @@index([architectureId])
  @@index([sprintPlanId])
  @@map("approvals")
}

// Durable, provider-neutral background job. Postgres itself is the queue —
// no Redis/BullMQ: workers claim rows with an atomic
// `UPDATE ... FOR UPDATE SKIP LOCKED` (see JobService.claimBatch), so this
// row is the only source of truth for both what to run and what already
// ran. `payload`/`result` are generic JSON because Job is infrastructure
// reused by unrelated future workflows — never store secrets/tokens here,
// and never store large artifacts (those belong elsewhere; see
// JOB_MAX_PAYLOAD_BYTES/JOB_MAX_RESULT_BYTES).
model Job {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     JobType
  status   JobStatus @default(QUEUED)
  priority Int       @default(0)

  payload Json
  result  Json?

  progress        Int     @default(0)
  progressMessage String?

  attemptCount Int @default(0)
  maxAttempts  Int @default(3)

  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  // Best-effort cooperative cancellation signal for a RUNNING job — the
  // handler observes this via JobExecutionContext.isCancellationRequested()
  // and decides on its own whether/when it's safe to stop. Never forces
  // termination: Sprint 8 has no external process to kill.
  cancelRequestedAt DateTime?

  // Claim ownership. Never exposed to API clients (see JobService.toRecord)
  // — internal to the worker/recovery mechanism only.
  lockedAt      DateTime?
  lockedBy      String?
  lockExpiresAt DateTime?

  errorCode    String?
  errorMessage String?

  // Optional dedupe scope: (type, projectId, idempotencyKey). Null keys are
  // distinct under Postgres's standard unique-index semantics, so this only
  // constrains callers that explicitly opt in.
  idempotencyKey String?

  // Optional coarse-to-fine job composition for future workflows (a parent
  // job spawning sub-jobs) — unused by Sprint 8's own handlers.
  parentJobId String?
  parent      Job?    @relation("JobHierarchy", fields: [parentJobId], references: [id], onDelete: SetNull)
  children    Job[]   @relation("JobHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events JobEvent[]

  @@unique([type, projectId, idempotencyKey])
  @@index([status, scheduledAt])
  @@index([status, priority, scheduledAt])
  @@index([projectId])
  @@index([lockExpiresAt])
  @@map("jobs")
}

// Append-only audit trail — mirrors the Approval model's own reasoning
// (Sprint 7): the mutable Job row shows current state, JobEvent shows how
// it got there. Never overwritten or deleted independently of the Job.
model JobEvent {
  id    String       @id @default(uuid())
  jobId String
  job   Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type  JobEventType

  message  String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@map("job_events")
}

// Low-level Git/filesystem lifecycle for a Project's isolated workspace —
// deliberately its own domain, not ProjectStatus (which tracks the planning
// workflow, not filesystem readiness). PostgreSQL only ever stores this
// metadata; the actual source code lives in Git/the filesystem (see
// WorkspaceService) — this row is never the source of truth for content.
enum WorkspaceStatus {
  NOT_PREPARED
  PREPARING
  READY
  INVALID
  FAILED
  CLEANING
}

// One row per Project (MVP: a single active workspace, never multiple
// worktrees/branches-per-task). `repositoryType`/`repositoryUrl` are
// deliberately NOT duplicated here — Project remains the source for those;
// this model only records the *actual prepared* Git state, which can only
// be known after running real Git commands (see GitService).
model ProjectWorkspace {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status WorkspaceStatus @default(NOT_PREPARED)

  // Absolute filesystem path — internal only, never returned by any API
  // response (see WorkspaceService.toRecord).
  workspacePath String?

  defaultBranch     String?
  developmentBranch String?
  currentBranch     String?

  remoteName String?
  // Sanitized: credentials are stripped before this is ever persisted.
  remoteUrl  String?

  headCommitSha String?

  errorCode    String?
  errorMessage String?

  preparedAt      DateTime?
  lastValidatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_workspaces")
}

// One record per coding-agent provider execution attempt (Sprint 10). This
// is the domain-rich record; the generic Job row (type CODING_AGENT_EXECUTION,
// referenced only loosely via backgroundJobId — never a Prisma relation, to
// keep Job itself provider-agnostic infrastructure) owns queueing/locking/
// cancellation-signaling. Never automatically retried (maxAttempts stays 1
// on the underlying Job): a partially-modified workspace makes blind retry
// unsafe, see CodingAgentService.
enum AgentJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model AgentJob {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Optional and unenforced in Sprint 10 (diagnostic-only) — wired for real
  // use once Sprint 12's Task orchestrator exists.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Plain string, not a Prisma relation — Job stays domain-agnostic
  // infrastructure (see Sprint 8 Job model comment).
  backgroundJobId String? @unique

  provider String
  model    String?

  status AgentJobStatus @default(QUEUED)

  // Bounded (see CODING_AGENT_MAX_INSTRUCTION_BYTES) and never written to
  // standard logs — see coding-agent.constants.ts.
  instruction String

  attemptCount Int @default(0)
  maxAttempts  Int @default(1)

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  summary String?

  // CodingAgentChangedFile[] / CodingAgentToolActivity[] / CodingAgentCommandActivity[]
  // — bounded, summarized JSON, never a raw provider transcript.
  changedFiles      Json?
  toolActivities    Json?
  commandActivities Json?

  inputTokens              Int?
  outputTokens             Int?
  cacheReadInputTokens     Int?
  cacheCreationInputTokens Int?
  turns                    Int?

  providerRequestId String?

  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([status])
  @@map("agent_jobs")
}

// A generated, versioned execution artifact for one Task (Sprint 11) —
// deliberately NOT a field on Task. Task is stable planning intent;
// TaskInstruction is fresh, repository-aware execution context regenerated
// immediately before each execution attempt (never during Sprint Planning,
// never edited by hand — see TaskInstructionService). Append-only: a Task
// retried later against a changed repository gets a new version, never an
// overwrite, so past instructions stay auditable.
model TaskInstruction {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  version Int

  // The Task's OWN artifact lineage at generation time — walked from
  // Task.sprintPlanId, never independently "latest" versions (see
  // TaskContextBuilder). Survives later regeneration of any of these.
  sprintPlanId      String
  architectureId    String
  projectAnalysisId String

  // Structured instruction contract (item 31) — kept alongside
  // finalInstruction so the UI/debugging never has to reparse the prompt.
  objective              String
  repositoryObservations Json
  implementationPlan     Json
  constraints            Json
  acceptanceCriteria     Json
  validationPlan         Json
  dependencyContext      Json
  risksOrWatchouts       Json

  // The single clean prompt CodingAgentProvider.executeTask ultimately
  // receives as `instruction` — provider-neutral, no Claude-specific markup.
  finalInstruction String

  // Bounded audit metadata about what produced this instruction — never a
  // raw file-content dump (see TaskContextBuilder / RepositoryTreeService).
  contextSnapshot Json

  // Exact repository state this instruction is valid for (item 6/55) —
  // isInstructionCurrent() compares this against the live HEAD.
  repositoryHeadSha String
  repositoryBranch  String?

  promptName        String
  promptVersion     String
  provider          String
  model             String
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  latencyMs         Int
  attempts          Int
  providerRequestId String?

  createdAt DateTime @default(now())

  @@unique([taskId, version])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@map("task_instructions")
}

// One row per orchestrated Sprint 12 execution *attempt* for a Task —
// distinct from AgentJob, which is one coding-provider invocation.
// TaskExecution owns the orchestration-level outcome (Task status
// transition, Git before/after state); AgentJob (referenced below by a
// plain id, not a Prisma relation, matching AgentJob.backgroundJobId's own
// cross-domain-reference style) owns the provider-specific detail.
model TaskExecution {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Sequential per-Task attempt counter — never reused, never decremented.
  attempt Int

  status TaskExecutionStatus @default(QUEUED)

  // The Task's status immediately before this execution locked it into
  // RUNNING (always PENDING or READY) — restored verbatim if this execution
  // fails before the coding agent ever starts, or is cancelled with no
  // resulting file changes.
  priorTaskStatus TaskStatus?

  // Cross-domain references by id only (see AgentJob.backgroundJobId for
  // the same pattern) — TaskInstruction/AgentJob/Job each own their own
  // lifecycle; TaskExecution only needs to remember which ones it used.
  taskInstructionId String?
  agentJobId        String? @unique
  backgroundJobId   String? @unique

  repositoryStartSha String?
  repositoryEndSha   String?

  // CodingAgentChangedFile[]-shaped, bounded — derived from a real `git
  // status` after execution, never from the provider's own narrative.
  changedFiles Json?

  // Bounded unstaged diff (see TaskExecutionConfigService) — truncated
  // rather than omitted so partial evidence always survives a failure.
  gitDiff          String?
  gitDiffTruncated Boolean @default(false)

  errorCode    String?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  // Set only once deterministic validation (Sprint 13) has passed and
  // successfully committed exactly this execution's change set. Null for
  // every FAILED/CANCELLED execution and for a SUCCEEDED one still awaiting
  // validation.
  commitSha String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, attempt])
  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([status])
  @@map("task_executions")
}

enum ValidationRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  CANCELLED
  SKIPPED
}

enum ValidationCheckType {
  LINT
  TYPECHECK
  UNIT_TEST
  INTEGRATION_TEST
  E2E_TEST
  BUILD
  CUSTOM
}

enum ValidationAttemptStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
}

// One deterministic-validation pass for a Task's REVIEWING TaskExecution —
// deliberately its own domain rather than reusing TaskExecution as the
// parent, since a single coding-agent execution may reasonably be
// (re-)validated more than once (e.g. flaky test infra) without ever
// re-running Claude.
model ValidationAttempt {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Cross-domain reference by id only (see TaskExecution.agentJobId for the
  // same pattern) — the TaskExecution this attempt validates.
  taskExecutionId String
  backgroundJobId String? @unique

  attempt Int
  status  ValidationAttemptStatus @default(QUEUED)

  startedAt   DateTime?
  completedAt DateTime?

  requiredPassed Int @default(0)
  requiredFailed Int @default(0)
  optionalPassed Int @default(0)
  optionalFailed Int @default(0)

  commitSha String?

  // SHA-256 over the sorted changed-file list + unstaged diff, captured
  // immediately before staging — an audit trail of exactly what change set
  // was validated. Not the gating mechanism itself (that's a changed-file-
  // set comparison) — purely for auditability.
  validatedDiffHash String?

  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs ValidationRun[]

  @@unique([taskId, attempt])
  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([status])
  @@map("validation_attempts")
}

// One deterministic check (lint/typecheck/unit test/build/...) within a
// ValidationAttempt.
model ValidationRun {
  id                  String            @id @default(uuid())
  validationAttemptId String
  validationAttempt   ValidationAttempt @relation(fields: [validationAttemptId], references: [id], onDelete: Cascade)
  projectId           String
  taskId              String
  taskExecutionId     String

  type ValidationCheckType
  name String

  // Trusted, server-resolved only — never accepted from a client. Args
  // stored as JSON (structured) alongside the display command string.
  command          String
  args             Json
  // Repository-relative only (e.g. "backend") — never an absolute
  // filesystem path (see the equivalent workspacePath exclusion on
  // TaskExecutionRecord).
  workingDirectory String?

  status   ValidationRunStatus @default(PENDING)
  required Boolean

  exitCode Int?

  // Bounded and best-effort secret-redacted before persistence.
  stdout          String?
  stderr          String?
  outputTruncated Boolean @default(false)

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validationAttemptId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("validation_runs")
}

// Orchestration status for one autonomous Sprint-execution attempt —
// deliberately its own status vocabulary, never reusing SprintStatus
// (PENDING/RUNNING/TESTING/PASSED/FAILED/BLOCKED), which remains the
// Sprint's own domain lifecycle. QUEUED/RUNNING/PAUSED are the only
// non-terminal values.
enum SprintExecutionStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  BLOCKED
  CANCELLED
}

// One row per autonomous multi-Task Sprint-execution attempt. Orchestrates
// (never duplicates) Sprint 12's TaskExecutionService and Sprint 13's
// TaskValidationService — this model only tracks progress/outcome across
// the whole Sprint, not any individual Task's own execution/validation
// detail (those remain on TaskExecution/ValidationAttempt exactly as
// Sprint 12/13 left them).
model SprintExecution {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId  String
  sprint    Sprint  @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  // The exact SprintPlan version being executed, pinned at start — plan
  // regeneration mid-execution must never silently change the Task graph
  // this execution is iterating over (item 84/85). Enforced structurally:
  // every Task lookup in the orchestration loop is scoped to this id.
  sprintPlanId String

  attempt Int
  status  SprintExecutionStatus @default(QUEUED)

  // Set by the currently (or most recently) selected Task — cleared once
  // the Sprint reaches a terminal state.
  currentTaskId String?

  // Checked once per loop iteration, at the Task-boundary only (item 90) —
  // never interrupts an in-flight Task execution/validation.
  pauseRequested Boolean @default(false)

  totalTasks   Int @default(0)
  passedTasks  Int @default(0)
  failedTasks  Int @default(0)
  blockedTasks Int @default(0)

  // Provenance chain: Sprint start HEAD -> (one commit per passed Task,
  // already recorded individually on each TaskExecution) -> Sprint final
  // HEAD (item 51-54).
  repositoryStartSha String?
  repositoryEndSha   String?

  backgroundJobId String? @unique

  errorCode    String?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sprintId, attempt])
  @@index([projectId, createdAt])
  @@index([sprintId])
  @@index([status])
  @@map("sprint_executions")
}

// Sprint 16's own lifecycle — deliberately never reuses SprintStatus or
// SprintExecutionStatus (item 4): "PASSED"/"COMPLETED" answer "did the
// mechanics finish"; this answers "did the delivered outcome actually meet
// the Sprint's agreed scope", a distinct question with its own workflow.
enum SprintAcceptanceStatus {
  PENDING
  REVIEWING
  READY_FOR_DECISION
  ACCEPTED
  REJECTED
  FAILED
  CANCELLED
}

// The AI reviewer's own advisory opinion — always kept structurally
// separate from `status` (item 116). Recommending ACCEPT never implies
// `status` becomes ACCEPTED; only an explicit human decision does that.
enum SprintAcceptanceRecommendation {
  ACCEPT
  ACCEPT_WITH_NOTES
  NEEDS_ATTENTION
  REJECT
}

// One versioned Sprint-delivery review — the quality gate between "the
// Sprint's Tasks all mechanically PASSED" (Sprint 12-14) and "a human
// agrees this Sprint actually delivered its agreed scope". Never mutates
// Task/TaskExecution/ValidationAttempt/SprintExecution rows (item 37/95-98)
// — purely an aggregation-and-decision record layered on top of them.
// Append-only per version, exactly like TaskInstruction/ProjectAnalysis/
// Architecture/SprintPlan: a re-review creates a new version, history
// preserved (item 7/74/105).
model SprintAcceptance {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId  String
  sprint    Sprint  @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  // Exact lineage (item 6) — never "the latest Sprint/Plan/Execution" at
  // read time. sprintPlanId already comes from the pinned
  // SprintExecution.sprintPlanId, not independently "current".
  sprintPlanId      String
  sprintExecutionId String

  version Int
  status  SprintAcceptanceStatus @default(PENDING)

  // Whether the deterministic hard gate (item 32) passed when this version
  // was generated. Always true for any version that reached past PENDING —
  // eligibility is re-checked at generation time, not inferred later.
  deterministicPassed Boolean @default(true)

  // Always present the moment evidence is built, independent of whether AI
  // review ever succeeds (item 35/36/115) — a plain-language system summary
  // with zero AI involvement, e.g. "5/5 Tasks passed, 21/21 required checks
  // passed, 5 local commits, 4 requirements covered, workspace clean at
  // abc1234".
  deterministicSummary String?

  // Bounded structured evidence (items 10-23) — never raw stdout/logs/full
  // diffs/full source. See SprintAcceptanceEvidence type.
  requirementCoverage Json?
  validationSummary   Json?
  commitSummary       Json?
  riskSummary         Json?
  changedFiles        Json?

  // Exact repository state this review was generated against (item 22/48) —
  // must equal SprintExecution.repositoryEndSha at generation time, and is
  // re-checked live before an Accept/Reject decision (item 50/52).
  repositoryHeadSha String?
  // SHA-256 over the canonical deterministic evidence object (item 49) —
  // proves a later Accept/Reject still corresponds to the exact evidence
  // shown, without needing to recompute+diff the whole object.
  evidenceHash      String?

  // ---- independent AI review (nullable — may never have run) -----------

  // 'COMPLETED' | 'UNAVAILABLE' | 'FAILED' — kept as a separate field from
  // `status` so "deterministic evidence exists but AI never weighed in" is
  // always distinguishable from "AI reviewed and flagged concerns" (item
  // 35/36/73).
  aiReviewStatus         String?
  aiSummary              String?
  objectiveAssessment    Json?
  architectureAssessment Json?
  riskAssessment         Json?
  findings               Json?
  recommendation         SprintAcceptanceRecommendation?

  promptName        String?
  promptVersion     String?
  provider          String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  latencyMs         Int?
  attempts          Int?
  providerRequestId String?

  errorCode    String?
  errorMessage String?

  // ---- human decision (item 23/54/55/105/106 — immutable once set) -----

  reviewedByUserId String?
  reviewedByUser   User?     @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  rejectionReason  String?
  reviewerNotes    String?

  backgroundJobId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sprintId, version])
  @@index([projectId, createdAt])
  @@index([sprintId])
  @@index([sprintExecutionId])
  @@index([status])
  @@map("sprint_acceptances")
}
